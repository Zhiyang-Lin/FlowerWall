<Project>

  <!--
    解决方案级共享属性。三个项目（逻辑库 / 桌面程序 / 诊断工具）都继承这里，
    避免在每个 csproj 里重复一遍语言版本与代码质量设置。
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <!-- 互操作层需要读写原生缓冲 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <RootNamespace>FlowerWall</RootNamespace>
    <Version>0.1.0</Version>
    <Product>花墙 FlowerWall —— 桌面音频可视化壁纸</Product>
    <Company>FlowerWall</Company>

    <!--
      刻意不启用 PublishTrimmed：
      WinForms / WPF 的反射路径较多，裁剪容易产生只在运行时才暴露的问题。
      可执行文件单文件 + 自包含已能把体积控制在可接受范围（见 README）。
      若后续确实要裁剪，务必回归测试托盘菜单、图标生成、配置序列化三条路径。
    -->
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
  </PropertyGroup>

</Project>
