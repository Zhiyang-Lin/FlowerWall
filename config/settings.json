    "centerColor": "#B5CFA6",
    "opacity": 1,
    "image": "",
    "fit": "Cover",
    "gradientStrength": 0
  },
  "record": {
    "diameter": 560,
    "labelDiameter": 250,
    "spindleDiameter": 16,
    "grooveCount": 72,
    "grooveIrregularity": 0.35,
    "grooveOpacity": 0.95,
    "grooveOuterBoost": 1.55,
    "specularStrength": 0.5,
    "wearStrength": 0.6,
    "rpm": 33.3,
    "activeSpeedFactor": 1.6,
    "silentSpeedFactor": 0.45,
    "speedSmoothing": 0.08,
    "spinStopThreshold": 0.02,
    "rimHighlight": 0.4,
