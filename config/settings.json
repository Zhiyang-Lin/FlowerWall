    "maxLength": 110,
    "minLength": 4,
    "startAngleDeg": -90,
    "minFrequency": 30,
    "maxFrequency": 16000,
    "gain": 1,
    "noiseFloorDb": -62,
    "ceilingDb": -3,
    "lowGain": 1.2,
    "midGain": 1,
    "highGain": 0.8,
    "attack": 0.5,
    "release": 0.1,
    "peakDecayPerSecond": 0.9,
    "flowSpeed": 0.035,
    "secondaryPhaseRadians": 1.5708,
    "secondaryAmplitude": 0.62,
    "secondaryOpacity": 0.4,
    "reflectionAmplitude": 0.75,
    "reflectionLength": 12,
    "reflectionOpacity": 0.14,
    "glowStrength": 0.18,
    "fftSize": 2048
